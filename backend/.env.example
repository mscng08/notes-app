# Backend environment variables (set these in Render / Railway dashboard)
# Option A - Railway MySQL plugin provides these automatically:
#   MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# Option B - any external MySQL:
DB_URL=jdbc:mysql://HOST:3306/notes_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_user
DB_PASSWORD=your_password
# Frontend URL(s), comma separated. Wildcards OK.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app
